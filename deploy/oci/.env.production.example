API_DOMAIN=api.example.com
DJANGO_SECRET_KEY=generate-a-long-random-value
POSTGRES_DB=app_muon_phong
POSTGRES_USER=app_muon_phong
POSTGRES_PASSWORD=generate-a-long-random-value

# In-app notifications work without SMTP. Configure these to deliver email too.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
